{
  "name": "webgl-dsl",
  "displayName": "WebGL DSL",
  "description": "Thin functional WebGL wrapper with strong typed GLSL DSL",
  "version": "0.1.15",
  "author": {
    "name": "Andrei Monkin",
    "email": "monkin.andrey@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/monkin/webgl-dsl",
  "keywords": ["WebGL", "GLSL", "DSL"],
  "type": "module",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs",
      "default": "./lib/index.js"
    }
  },
  "files": ["lib/"],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "targets": {
    "module": false,
    "types": false
  },
  "scripts": {
    "start": "npm run build:examples && vite",
    "docs": "typedoc --tsconfig tsconfig.lib.json --out docs src",
    "build": "npm run clean && npm run build:lib && npm run build:examples",
    "build:examples": "vite build && pug --pretty index.pug",
    "build:lib": "vite build -c vite.lib.config.ts",
    "clean": "rm -rf lib docs examples/build",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "test": "jest",
    "prepublishOnly": "npm run test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/gl": "6.0.5",
    "@types/jest": "29.5.12",
    "@types/jest-image-snapshot": "6.4.0",
    "@types/upng-js": "2.1.5",
    "gl": "8.1.6",
    "jest": "29.7.0",
    "jest-image-snapshot": "6.5.1",
    "jstransformer-markdown-it": "3.0.0",
    "milligram": "1.4.1",
    "pug-cli": "1.0.0-alpha6",
    "ts-jest": "29.4.4",
    "ts-node": "10.9.2",
    "typedoc": "0.28.13",
    "typescript": "5.9.2",
    "upng-js": "2.1.0",
    "vite": "7.1.7",
    "vite-plugin-dts": "4.5.4"
  }
}
